<div class="offcanvas offcanvas-end ai-offcanvas" tabindex="-1" id="aiReportPanel" aria-labelledby="aiReportLabel">
    <div class="offcanvas-header border-bottom">
        <h5 class="offcanvas-title fw-bold" id="aiReportLabel">
            <i class="fa-solid fa-robot text-primary me-2"></i>Cairo-AI Climate Analyst
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
    </div>
    <div class="offcanvas-body">
        <div id="aiLoading" class="text-center py-5 d-none">
            <div class="spinner-grow text-primary" role="status"></div>
            <p class="mt-3 text-muted fw-bold">Analyzing contextual radiative data via Gemini...</p>
        </div>

        <div id="aiContent" class="d-none">
            <span class="ai-badge mb-3 d-inline-block" id="aiBadgeText">Analysis Report</span>

            <div id="pdfExportArea">
                <div id="aiTextBody" class="ai-report-content"></div>
            </div>

            <div class="mt-4 p-3 rounded-4 bg-light small text-muted border">
                <i class="fa-solid fa-circle-info me-1"></i>
                <span id="aiDisclaimer">Real-time analysis derived from the database.</span>
            </div>
            <button class="btn btn-outline-primary btn-sm mt-3 w-100" onclick="exportAIToPDF()">
                <i class="fa-solid fa-file-pdf me-2"></i>Export as PDF Report
            </button>
        </div>
    </div>
</div>