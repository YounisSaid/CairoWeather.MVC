@{
    ViewData["Title"] = "1-Month Analysis";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3 card p-3 shadow-sm border time-control-card" style="border-left-color: #3b82f6;">
    <h5 class="fw-bold mb-0 text-dark"><i class="fa-solid fa-calendar-week text-primary me-2"></i>30-Day Radiative Aggregation</h5>
    <div class="d-flex align-items-center gap-2">
        <label for="monthPicker" class="fw-bold mb-0">Select Month:</label>
        <input type="month" id="monthPicker" class="form-control fw-bold border-secondary" value="2022-04" min="2015-01" max="2025-12">
    </div>
</div>

<div class="row">
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header">1. Cloud Radiative Forcing</div>
            <div class="card-body">
                <div class="chart-container"><canvas id="m1"></canvas></div>
                <div class="analysis-text"><strong>Analysis:</strong> Quantifies the deficit of solar energy blocked by cloud cover.</div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header">2. Radiation-Wind Synergy</div>
            <div class="card-body">
                <div class="chart-container"><canvas id="m3"></canvas></div>
                <div class="analysis-text"><strong>Analysis:</strong> Checks if high-wind days naturally compensate for low-solar (cloudy) days.</div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header">3. Diurnal Temp Range</div>
            <div class="card-body">
                <div class="chart-container"><canvas id="m5"></canvas></div>
                <div class="analysis-text"><strong>Analysis:</strong> Evaluates the daily spread between max and min temperatures.</div>
            </div>
        </div>
    </div>
    <div class="col-xl-6 mb-4">
        <div class="card h-100">
            <div class="card-header">4. Fog Risk</div>
            <div class="card-body">
                <div class="chart-container"><canvas id="m10"></canvas></div>
                <div class="analysis-text"><strong>Analysis:</strong> Tracks the daily minimum temperature against the dew point.</div>
            </div>
        </div>
    </div>
</div>

<div class="row mt-2 mb-5">
    <div class="col-12">
        <div class="card border-0 shadow-sm" style="border-top: 4px solid #3b82f6 !important;">
            <div class="card-body p-4">
                <h4 class="text-dark fw-bold mb-4"><i class="fa-solid fa-book-open-reader text-primary me-2"></i>Monthly Aggregations & Physics Documentation</h4>

                <div class="row g-4">
                    <div class="col-md-6">
                        <h5 class="text-primary fw-bold border-bottom pb-2 mb-3"><i class="fa-solid fa-solar-panel me-2"></i>Solar Forcing & Hybrid Synergy</h5>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #f8fafc;">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-cloud-sun text-warning me-2"></i>Graph 1: Cloud Radiative Forcing (CRF)</h6>
                            <p class="text-muted small mb-2">Evaluates the total daily loss of solar potential. By comparing the theoretical clear sky against actual irradiance, engineers can size battery storage systems to bridge the deficit on cloudy days.</p>

                            <div class="bg-white border rounded p-2 mb-2 text-center text-dark fw-bold" style="font-family: 'Cambria Math', serif; letter-spacing: 0.5px;">
                                CRF = GHI<sub>clear_sky</sub> - GHI<sub>actual</sub>
                            </div>

                            <ul class="text-muted small mb-0" style="padding-left: 1.5rem;">
                                <li><strong>X-Axis:</strong> Days of the Month (e.g., 01 Apr to 30 Apr)</li>
                                <li><strong>Parameter 1:</strong> <code>Clear Sky GHI</code> (Theoretical Max W/m&sup2;)</li>
                                <li><strong>Parameter 2:</strong> <code>Actual GHI</code> (Measured/Attenuated W/m&sup2;)</li>
                            </ul>
                        </div>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #f8fafc;">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-fan text-success me-2"></i>Graph 2: Radiation-Wind Synergy</h6>
                            <p class="text-muted small mb-2">Analyzes hybrid renewable potential. Inverse correlation (high wind on low sun days) proves that hybrid solar-wind microgrids are viable and reliable for specific climates.</p>

                            <div class="bg-white border rounded p-2 mb-2 text-center text-dark fw-bold" style="font-family: 'Cambria Math', serif; letter-spacing: 0.5px;">
                                WPD = &frac12; &times; &rho; &times; v&sup3;
                            </div>

                            <ul class="text-muted small mb-0" style="padding-left: 1.5rem;">
                                <li><strong>Parameter 1:</strong> <code>GHI</code> (Daily Average Irradiance)</li>
                                <li><strong>Parameter 2:</strong> <code>Wind Power Density</code> (W/m&sup2; extracted from air density, &rho;, and wind velocity cubed, v&sup3;)</li>
                            </ul>
                        </div>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #eff6ff; font-family: monospace; font-size: 0.9rem;">
                            <div class="fw-bold text-dark mb-1">C# Backend Logic (CRF & Synergy)</div>
                            <div class="text-muted small mb-2" style="font-family: 'Segoe UI', sans-serif;">Grouping 24 hourly readings into a daily average using LINQ:</div>
                            <div class="text-primary mb-1">dailyGroups.Select(g => g.Average(r => r.ClearSkyRadiation))</div>
                            <div class="text-primary">dailyGroups.Select(g => g.Average(r => r.WindPowerDensity))</div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h5 class="text-primary fw-bold border-bottom pb-2 mb-3"><i class="fa-solid fa-temperature-arrow-up me-2"></i>Thermal Stress & Micro-climate</h5>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #f8fafc;">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-arrows-up-down text-danger me-2"></i>Graph 3: Diurnal Temp Range (DTR)</h6>
                            <p class="text-muted small mb-2">Measures the daily temperature spread. High DTR days cause aggressive thermal expansion and contraction, accelerating microcracking in PV modules and fatiguing mounting structures.</p>

                            <div class="bg-white border rounded p-2 mb-2 text-center text-dark fw-bold" style="font-family: 'Cambria Math', serif; letter-spacing: 0.5px;">
                                DTR = T<sub>max</sub> - T<sub>min</sub>
                            </div>

                            <ul class="text-muted small mb-0" style="padding-left: 1.5rem;">
                                <li><strong>Parameter 1:</strong> <code>DTR</code> (&Delta;T between peak day heat and lowest night cold in &deg;C)</li>
                                <li><strong>Parameter 2:</strong> <code>Avg GHI</code> (Plotted to show how clear skies increase DTR)</li>
                            </ul>
                        </div>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #f8fafc;">
                            <h6 class="fw-bold text-dark mb-2"><i class="fa-solid fa-smog text-secondary me-2"></i>Graph 4: Fog & Soiling Risk Profile</h6>
                            <p class="text-muted small mb-2">Aggregates the daily minimum temperature against the daily average dew point. When the minimum temperature approaches the dew point, morning fog is highly probable, leading to severe module soiling (mud formation).</p>

                            <div class="bg-white border rounded p-2 mb-2 text-center text-dark fw-bold" style="font-family: 'Cambria Math', serif; letter-spacing: 0.5px;">
                                Fog Risk &prop; (T<sub>min</sub> &approx; T<sub>dew</sub>)
                            </div>

                            <ul class="text-muted small mb-0" style="padding-left: 1.5rem;">
                                <li><strong>Parameter 1:</strong> <code>Min Temp</code> (Daily lowest &deg;C, T<sub>min</sub>)</li>
                                <li><strong>Parameter 2:</strong> <code>Dew Point</code> (Daily average &deg;C, T<sub>dew</sub>)</li>
                            </ul>
                        </div>

                        <div class="p-3 rounded-3 mb-3 border" style="background-color: #eff6ff; font-family: monospace; font-size: 0.9rem;">
                            <div class="fw-bold text-dark mb-1">C# Backend Logic (DTR & Fog Risk)</div>
                            <div class="text-muted small mb-2" style="font-family: 'Segoe UI', sans-serif;">Extracting thermal boundaries from daily grouped data:</div>
                            <div class="text-primary mb-1">DTR = g.Max(r => r.Temperature2m) - g.Min(r => r.Temperature2m)</div>
                            <div class="text-primary">Fog Risk = g.Min(r => r.Temperature2m) ↔ g.Average(r => r.DewPoint2m)</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadMonthlyData() {
            const monthVal = document.getElementById('monthPicker').value;
            if (!monthVal) return;
            try {
                const [year, month] = monthVal.split('-');
                const response = await fetch(`/api/weatheranalytics/monthly?year=${year}&month=${parseInt(month)}`);
                const data = await response.json();

                initChart('m1', 'line', { labels: data.cloudRadiativeForcing.labels, datasets: createDatasets(data.cloudRadiativeForcing.datasets) });
                initChart('m3', 'line', { labels: data.radiationWindSynergy.labels, datasets: createDatasets(data.radiationWindSynergy.datasets) });
                initChart('m5', 'line', { labels: data.diurnalTempRange.labels, datasets: createDatasets(data.diurnalTempRange.datasets) });
                initChart('m10', 'line', { labels: data.fogRisk.labels, datasets: createDatasets(data.fogRisk.datasets) });
            } catch (error) {
                console.error("Error loading monthly data:", error);
            }
        }
        document.getElementById('monthPicker').addEventListener('change', loadMonthlyData);
        window.onload = loadMonthlyData;
    </script>
}