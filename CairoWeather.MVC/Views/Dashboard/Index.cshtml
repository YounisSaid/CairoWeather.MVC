@{
    ViewData["Title"] = "Cairo Energy Analysis Dashboard";
}

<!-- Bootstrap 5 CSS & FontAwesome -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    :root {
        --bg-body: #f8fafc;
        --bg-card: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --primary: #3b82f6;
    }

    body {
        background-color: var(--bg-body);
        color: var(--text-main);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .nav-pills .nav-link {
        color: var(--text-muted);
        border-radius: 0.5rem;
        margin-right: 0.5rem;
        font-weight: 600;
        padding: 0.6rem 1.25rem;
        transition: all 0.2s ease;
    }
    
    .nav-pills .nav-link:hover:not(.active) { background-color: #e2e8f0; }
    .nav-pills .nav-link.active {
        background-color: var(--primary);
        color: white;
        box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.4);
    }

    .card {
        background-color: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
        margin-bottom: 1.5rem;
        transition: transform 0.2s ease;
    }

    .card-header {
        background-color: transparent;
        border-bottom: 1px solid var(--border-color);
        font-weight: 600;
        color: var(--text-main);
        font-size: 0.9rem;
        padding: 1rem 1.25rem;
    }

    .card-body { padding: 1.25rem; }

    .time-control-card {
        background: linear-gradient(135deg, #eff6ff 0%, #ffffff 100%);
        border-left: 4px solid var(--primary);
    }

    .form-range::-webkit-slider-thumb {
        background: var(--primary);
        width: 20px;
        height: 20px;
    }

    .selected-time-display {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--primary);
        line-height: 1;
    }

    .stat-value {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-main);
    }

    .stat-label {
        color: var(--text-muted);
        font-size: 0.85rem;
        font-weight: 600;
        text-transform: uppercase;
    }

    .chart-container {
        position: relative;
        height: 260px;
        width: 100%;
    }

    .icon-box {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }

    .bg-red-light { background-color: #fee2e2; color: #ef4444; }
    .bg-blue-light { background-color: #e0f2fe; color: #0ea5e9; }
    .bg-green-light { background-color: #d1fae5; color: #10b981; }
    .bg-yellow-light { background-color: #fef3c7; color: #f59e0b; }
    .bg-indigo-light { background-color: #e0e7ff; color: #4f46e5; }
    .bg-slate-light { background-color: #f1f5f9; color: #475569; }

    .analysis-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        border-left: 3px solid #cbd5e1;
        padding-left: 0.75rem;
        margin-top: 1rem;
        line-height: 1.4;
    }
</style>

<div class="container-fluid px-4 py-4">
    <div class="d-flex align-items-center mb-4 gap-2">
        <i class="fa-solid fa-solar-panel text-primary fs-3"></i>
        <h2 class="fw-bold text-dark mb-0">Cairo <span class="text-primary">Energy Grid</span> Dashboard</h2>
    </div>

    <!-- TABS -->
    <ul class="nav-pills nav mb-4" id="pills-tab" role="tablist">
        <li class="nav-item"><button class="nav-link active" id="pills-hourly-tab" data-bs-toggle="pill" data-bs-target="#pills-hourly" type="button"><i class="fa-solid fa-clock me-1"></i>Hourly Micro-Climate</button></li>
        <li class="nav-item"><button class="nav-link" id="pills-yearly-tab" data-bs-toggle="pill" data-bs-target="#pills-yearly" type="button"><i class="fa-solid fa-calendar-days me-1"></i>1-Year Seasonal Yield</button></li>
        <li class="nav-item"><button class="nav-link" id="pills-decade-tab" data-bs-toggle="pill" data-bs-target="#pills-decade" type="button"><i class="fa-solid fa-building-columns me-1"></i>10-Year Bankability</button></li>
    </ul>

    <div class="tab-content" id="pills-tabContent">
        
        <!-- ========================================== -->
        <!-- SECTION 1: HOURLY -->
        <!-- ========================================== -->
        <div class="tab-pane fade show active" id="pills-hourly" role="tabpanel">
            <div class="card time-control-card p-4 mb-4">
                <div class="row align-items-center">
                    <div class="col-md-3 text-center text-md-start mb-3 mb-md-0">
                        <input type="date" id="datePicker" class="form-control mb-2 fw-bold text-primary" value="2020-03-13" min="2015-01-01" max="2025-12-31" style="border: 2px solid var(--primary);">
                        <div class="selected-time-display" id="displayTime">12:00 PM</div>
                        <div class="text-muted small mt-1" id="dayPhaseLabel">Midday / Peak Heat & Sun</div>
                    </div>
                    <div class="col-md-9">
                        <label for="hourSlider" class="form-label fw-bold"><i class="fa-solid fa-sliders me-2"></i>Drag to inspect 24-hour exact conditions</label>
                        <input type="range" class="form-range" min="0" max="23" step="1" id="hourSlider" value="12">
                        <div class="d-flex justify-content-between text-muted small mt-1">
                            <span>Midnight</span><span>6:00 AM</span><span>Noon</span><span>6:00 PM</span><span>11:00 PM</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPIs -->
            <div class="row mb-4">
                <div class="col-lg-4 col-md-6 mb-3"><div class="card p-3 h-100 mb-0"><div class="d-flex justify-content-between">
                    <div><div class="stat-label">Temperature</div><div class="stat-value" id="valTemp">-- °C</div><div class="small text-muted">Feels like: <span id="valAppTemp" class="fw-bold">-- °C</span></div></div>
                    <div class="icon-box bg-red-light"><i class="fa-solid fa-temperature-full"></i></div>
                </div></div></div>
                <div class="col-lg-4 col-md-6 mb-3">
                    <div class="card p-3 h-100 mb-0">
                        <div class="d-flex justify-content-between">
                            <div><div class="stat-label">Cloud Cover </div><div class="stat-value" id="valCloud">-- %</div><div class="small text-muted">Cloud Cover %</div></div>
                            <div class="icon-box bg-yellow-light"><i class="fa-solid fa-sun"></i></div>
                </div></div></div>
                <div class="col-lg-4 col-md-6 mb-3"><div class="card p-3 h-100 mb-0"><div class="d-flex justify-content-between">
                    <div><div class="stat-label">Wind Profile (100m)</div><div class="stat-value" id="valWind">-- km/h</div><div class="small text-muted">Gusts: <span id="valGust" class="fw-bold">-- km/h</span></div></div>
                    <div class="icon-box bg-green-light"><i class="fa-solid fa-wind"></i></div>
                </div></div></div>
                <div class="col-lg-4 col-md-6 mb-3"><div class="card p-3 h-100 mb-0"><div class="d-flex justify-content-between">
                    <div><div class="stat-label">Humidity & VPD</div><div class="stat-value" id="valHum">-- %</div><div class="small text-muted">VPD: <span id="valVpd" class="fw-bold">-- kPa</span></div></div>
                    <div class="icon-box bg-blue-light"><i class="fa-solid fa-droplet"></i></div>
                </div></div></div>
                <div class="col-lg-4 col-md-6 mb-3"><div class="card p-3 h-100 mb-0"><div class="d-flex justify-content-between">
                    <div><div class="stat-label">Dew Point</div><div class="stat-value" id="valDew">-- °C</div><div class="small text-muted">Condensation risk</div></div>
                    <div class="icon-box bg-indigo-light"><i class="fa-solid fa-cloud-showers-water"></i></div>
                </div></div></div>
                <div class="col-lg-4 col-md-6 mb-3"><div class="card p-3 h-100 mb-0"><div class="d-flex justify-content-between">
                    <div><div class="stat-label">Pressure & ET₀</div><div class="stat-value" id="valPress">-- hPa</div><div class="small text-muted">ET₀: <span id="valEt0" class="fw-bold">-- mm</span></div></div>
                    <div class="icon-box bg-slate-light"><i class="fa-solid fa-gauge-high"></i></div>
                </div></div></div>
            </div>

            <h5 class="fw-bold mb-3 mt-4"><i class="fa-solid fa-microscope me-2"></i>24-Hour Micro-Climate Data</h5>
            
            <div class="row">
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">1. Wind Shear Profile</div><div class="card-body"><div class="chart-container"><canvas id="h1"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Compares ground-level wind (10m) with typical turbine hub height (100m). Stronger, smoother winds at higher altitudes are essential for maximizing wind turbine energy capture.</div>
                </div></div></div>
                
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">2. Temperature & Radiation Curve</div><div class="card-body"><div class="chart-container"><canvas id="h2"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Tracks ambient temperature alongside solar radiation levels. Solar panels generate maximum power during high radiation, but their electrical efficiency drops significantly as ambient heat rises.</div>
                </div></div></div>
                
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">3. Atmospheric Cooling</div><div class="card-body"><div class="chart-container"><canvas id="h3"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Vapor Pressure Deficit (VPD) measures how dry the air is, driving Evapotranspiration (ET₀). High midday spikes indicate rapid moisture loss, affecting local atmospheric cooling around the site.</div>
                </div></div></div>
                
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">4. Thermal Mass (Soil Temp)</div><div class="card-body"><div class="chart-container"><canvas id="h4"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Shows how surface and shallow soil layers absorb daily solar heat. High soil temperatures radiate heat back into ground-mounted panels, lowering their operational efficiency and lifespan.</div>
                </div></div></div>
                
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">5. Cloud Strata Impact</div><div class="card-body"><div class="chart-container"><canvas id="h5"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Breaks down cloud cover by altitude density. Thick, low-level clouds heavily block direct sunlight, causing sudden and unpredictable drops in your site's solar energy production.</div>
                </div></div></div>
                
                <div class="col-xl-4 col-md-6"><div class="card"><div class="card-header">6. Turbine Safety Window</div><div class="card-body"><div class="chart-container"><canvas id="h6"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Maps the 100m wind speed against a typical 12km/h turbine "cut-in" threshold. It shows exactly how many hours today the wind is strong enough to spin blades and generate power.</div>
                </div></div></div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- SECTION 2: YEARLY -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="pills-yearly" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-calendar-days me-2"></i>Annual Aggregation</h5>
                <select class="form-select form-select-lg fw-bold text-primary w-auto shadow-sm" id="yearPicker" style="border: 2px solid var(--primary);"></select>
            </div>
            <div class="row">
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">1. Solar Irradiance Base (MJ/m²)</div><div class="card-body"><div class="chart-container"><canvas id="y1"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> The monthly sum of solar energy hitting the site. This is the single most critical metric for calculating the Annual Energy Production (AEP) and expected financial returns of a solar farm.</div>
                </div></div></div>
                
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">2. Sunlight vs Cloud Cover</div><div class="card-body"><div class="chart-container"><canvas id="y2"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Compares total unobstructed daily sunlight hours against average cloud blockage. This helps predict seasonal dips in solar generation and plan for required battery storage capacity.</div>
                </div></div></div>
                
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">3. HVAC Stress Envelopes</div><div class="card-body"><div class="chart-container"><canvas id="y3"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Tracks the absolute maximum and minimum temperatures per month. This defines the physical survival limits for hardware and sizes the HVAC cooling needed for battery containers.</div>
                </div></div></div>
                
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">4. Wind Energy vs Gusts</div><div class="card-body"><div class="chart-container"><canvas id="y4"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Shows the maximum sustained wind potential versus dangerous gust spikes. High sustained winds mean good energy, but extreme gusts require stronger, more expensive steel mountings.</div>
                </div></div></div>
                
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">5. Deep Soil Saturation</div><div class="card-body"><div class="chart-container"><canvas id="y5"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Long-term soil temperature trends deep underground. Hotter soil increases the electrical resistance of buried export cables, potentially requiring thicker, costlier copper wiring.</div>
                </div></div></div>
                
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">6. VPD vs ET₀</div><div class="card-body"><div class="chart-container"><canvas id="y6"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Measures the harshness and evaporative demand of the seasonal climate. High evaporation strips moisture from the environment, leading to dustier conditions that require more frequent panel washing.</div>
                </div></div></div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- NEW SECTION 3: 10-YEAR BANKABILITY (9 Charts) -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="pills-decade" role="tabpanel">
            <div class="mb-4 bg-white p-4 rounded-4 shadow-sm border" style="border-left: 5px solid var(--primary) !important;">
                <h4 class="fw-bold mb-2"><i class="fa-solid fa-file-contract text-primary me-2"></i>10-Year Bankability & Degradation Report</h4>
                <p class="text-muted mb-0">Decade-scale macro-environmental shifts determining hardware lifespan, structural wear, and investor revenue security over the lifecycle of the power plant (2015-2025).</p>
            </div>

            <div class="row">
                <!-- Chart 16 -->
                <div class="col-xl-12 mb-4"><div class="card"><div class="card-header">1. Long-Term Irradiance Stability vs Cloud Blockage</div><div class="card-body"><div class="chart-container" style="height: 300px;"><canvas id="d1"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Financial banks require flat, predictable solar stability over 10 years. A consistent irradiance trend guarantees reliable long-term energy yield forecasts and secure loan repayments.</div>
                </div></div></div>
                
                <!-- Chart 17 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">2. Thermal Degradation Events (>35°C & >40°C)</div><div class="card-body"><div class="chart-container"><canvas id="d2"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Counts the number of extremely hot days each year. Frequent extreme heat accelerates the chemical degradation of solar panels and forces inverters to throttle output to prevent fires.</div>
                </div></div></div>
                
                <!-- Chart 18 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">3. Structural Wind Loads (Mean vs Extreme Gusts)</div><div class="card-body"><div class="chart-container"><canvas id="d3"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> A decade view of absolute peak wind gusts. This historical worst-case data is mandatory for engineering the structural safety limits of tracker motors and turbine towers.</div>
                </div></div></div>

                <!-- Chart 19 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">4. Sunlight Efficiency Ratio (%)</div><div class="card-body"><div class="chart-container"><canvas id="d4"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> The percentage of actual daylight hours that experienced pure, direct sunshine. Higher ratios mean less atmospheric interference and more efficient, reliable solar power generation.</div>
                </div></div></div>

                <!-- Chart 20 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">5. Annual Evaporative Water Loss (Total ET₀)</div><div class="card-body"><div class="chart-container"><canvas id="d5"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Total water evaporation per year. In arid sites, high evaporation means zero natural rain-washing, forcing plant operators to budget for expensive mechanical panel cleaning.</div>
                </div></div></div>

                <!-- Chart 21 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">6. Extreme Wet-Bulb Temperature limits</div><div class="card-body"><div class="chart-container"><canvas id="d6"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Wet-bulb temperature combines heat and humidity. High values severely limit the efficiency of water-based cooling towers and create dangerous working conditions for maintenance crews.</div>
                </div></div></div>

                <!-- Chart 22 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">7. Deep Underground Thermal Saturation (0-100cm)</div><div class="card-body"><div class="chart-container"><canvas id="d7"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> 10-year shifts in deep soil heat. Continually rising soil temperatures permanently lower the maximum power rating of buried electrical cables, causing dangerous grid bottlenecks.</div>
                </div></div></div>

                <!-- Chart 23 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">8. Deep Soil Moisture Retention / Aridity Index</div><div class="card-body"><div class="chart-container"><canvas id="d8"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Decade trends in ground water content. Extremely dry soils lose their electrical conductivity, requiring massive, expensive copper grounding grids to protect equipment from lightning strikes.</div>
                </div></div></div>

                <!-- Chart 24 -->
                <div class="col-xl-6 mb-4"><div class="card"><div class="card-header">9. Relative Humidity Corrosion Risk</div><div class="card-body"><div class="chart-container"><canvas id="d9"></canvas></div>
                    <div class="analysis-text"><strong>Analysis:</strong> Tracks sustained high and low humidity envelopes. Persistent high humidity aggressively accelerates rust on steel tracker frames and speeds up the degradation of exposed wiring.</div>
                </div></div></div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        // Custom Plugin to draw a synchronized vertical marker at the selected hour
        const verticalLinePlugin = {
            id: 'verticalLine',
            afterDatasetsDraw: function(chart, args, options) {
                if (options && options.draw) {
                    const ctx = chart.ctx;
                    const xAxis = chart.scales.x;
                    const yAxis = chart.scales.y;
                    const hour = options.hour || 0;
                    
                    const x = xAxis.getPixelForValue(hour);
                    const topY = chart.chartArea.top;
                    const bottomY = chart.chartArea.bottom;

                    ctx.save();
                    
                    // Draw Box
                    ctx.fillStyle = '#ef4444'; // Bright Red marker
                    const text = hour + 'h';
                    ctx.font = 'bold 12px "Segoe UI", sans-serif';
                    const textWidth = ctx.measureText(text).width;
                    const bWidth = textWidth + 16;
                    const bHeight = 22;
                    
                    // Clamp box so it doesn't go off the edge of the canvas at hour 0 or 23
                    let boxX = x - bWidth / 2;
                    if (boxX < chart.chartArea.left) boxX = chart.chartArea.left;
                    if (boxX + bWidth > chart.chartArea.right) boxX = chart.chartArea.right - bWidth;

                    ctx.fillRect(boxX, topY, bWidth, bHeight);
                    
                    // Draw Text inside box
                    ctx.fillStyle = 'white';
                    ctx.textAlign = 'center';
                    ctx.textBaseline = 'middle';
                    ctx.fillText(text, boxX + bWidth / 2, topY + bHeight / 2);

                    // Draw Vertical Dashed Line
                    ctx.beginPath();
                    ctx.moveTo(x, topY + bHeight);
                    ctx.lineTo(x, bottomY);
                    ctx.lineWidth = 2;
                    ctx.strokeStyle = '#ef4444';
                    ctx.setLineDash([5, 5]);
                    ctx.stroke();

                    ctx.restore();
                }
            }
        };
        Chart.register(verticalLinePlugin);

        let chartInstances = {};
        let hourlyData = null;
        Chart.defaults.font.family = "'Segoe UI', Roboto, sans-serif";
        Chart.defaults.color = '#64748b';
        Chart.defaults.plugins.legend.position = 'bottom';
        const gLine = '#f1f5f9';
        const opts = { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { color: gLine } }, y: { grid: { color: gLine } } } };

        function resetChart(id) {
            if (chartInstances[id]) chartInstances[id].destroy();
            return document.getElementById(id).getContext('2d');
        }

        // --- SECTION 1: HOURLY LOGIC ---
        async function fetchHourlyData() {
            const date = document.getElementById('datePicker').value;
            try {
                const response = await fetch(`/Dashboard/GetHourlyData?date=${date}`);
                hourlyData = await response.json();
                if (!hourlyData) return;

                renderHourlyCharts();
                updateHourlyKPIs(document.getElementById('hourSlider').value);
            } catch (error) { console.error(error); }
        }

        function updateHourlyKPIs(h) {
            if (!hourlyData) return;
            const ds = hourlyData.datasets;
            
            const hInt = parseInt(h);
            const ampm = hInt >= 12 ? 'PM' : 'AM';
            const displayH = hInt % 12 || 12;
            document.getElementById('displayTime').innerText = `${displayH}:00 ${ampm}`;

            let phase = "Night";
            if (hInt >= 5 && hInt < 8) phase = "Dawn / Sunrise";
            else if (hInt >= 8 && hInt < 12) phase = "Morning / Warming Up";
            else if (hInt >= 12 && hInt < 16) phase = "Midday / Peak Heat & Sun";
            else if (hInt >= 16 && hInt < 19) phase = "Late Afternoon";
            else if (hInt >= 19) phase = "Evening";
            if(document.getElementById('dayPhaseLabel')) document.getElementById('dayPhaseLabel').innerText = phase;

            document.getElementById('valTemp').innerText = ds.temp[h].toFixed(1) + " °C";
            if(document.getElementById('valAppTemp')) document.getElementById('valAppTemp').innerText = ds.appTemp ? ds.appTemp[h].toFixed(1) + " °C" : "-- °C";
            document.getElementById('valCloud').innerText = (ds.cloudTotal ? ds.cloudTotal[h] : (ds.cloudLow ? ds.cloudLow[h] : 0)).toFixed(0) + " %";
            if(document.getElementById('valRad')) document.getElementById('valRad').innerText = ds.radiation ? ds.radiation[h].toFixed(0) + " W/m²" : "0 W/m²";
            document.getElementById('valWind').innerText = ds.wind100m[h].toFixed(1) + " km/h";
            if(document.getElementById('valGust')) document.getElementById('valGust').innerText = ds.gusts ? ds.gusts[h].toFixed(1) + " km/h" : "-- km/h";
            if(document.getElementById('valHum')) document.getElementById('valHum').innerText = ds.rh ? ds.rh[h].toFixed(0) + " %" : "-- %";
            document.getElementById('valVpd').innerText = ds.vpd[h].toFixed(2) + " kPa";
            document.getElementById('valDew').innerText = ds.dewPoint[h].toFixed(1) + " °C";
            if(document.getElementById('valPress')) document.getElementById('valPress').innerText = ds.pressSfc ? ds.pressSfc[h].toFixed(0) + " hPa" : "-- hPa";
            document.getElementById('valEt0').innerText = ds.et0[h].toFixed(2) + " mm";

            // Update Vertical Line efficiently across all hourly charts
            for (let i = 1; i <= 6; i++) {
                let chart = chartInstances['h' + i];
                if (chart && chart.options.plugins.verticalLine) {
                    chart.options.plugins.verticalLine.hour = hInt;
                    chart.update('none'); // Update strictly visual frame, no long animation
                }
            }
        }

        function renderHourlyCharts() {
            const ds = hourlyData.datasets;
            const lbl = hourlyData.labels;
            const currentHour = parseInt(document.getElementById('hourSlider').value) || 12;

            // Base options injected with vertical line plugin
            const hOpts = { 
                ...opts, 
                plugins: { 
                    ...opts.plugins, 
                    verticalLine: { draw: true, hour: currentHour } 
                } 
            };

            chartInstances['h1'] = new Chart(resetChart('h1'), { type: 'line', data: { labels: lbl, datasets: [ 
                { label: 'Hub Height (100m)', data: ds.wind100m, borderColor: '#3b82f6', backgroundColor: 'rgba(59,130,246,0.1)', fill: true, tension: 0.4 }, 
                { label: 'Surface (10m)', data: ds.wind10m, borderColor: '#64748b', borderDash: [5,5], tension: 0.4 } 
            ]}, options: hOpts });

            chartInstances['h2'] = new Chart(resetChart('h2'), { type: 'bar', data: { labels: lbl, datasets: [ 
                { label: 'Temp', type: 'line', data: ds.temp, borderColor: '#ef4444', tension: 0.4, yAxisID: 'y' }, 
                { label: 'Radiation (Mock/Missing)', data: ds.radiation || Array(24).fill(0), backgroundColor: '#f59e0b', yAxisID: 'y1' } 
            ]}, options: { ...hOpts, scales: { ...opts.scales, y1: { position: 'right' } } } });

            chartInstances['h3'] = new Chart(resetChart('h3'), { type: 'line', data: { labels: lbl, datasets: [ 
                { label: 'VPD', data: ds.vpd, borderColor: '#0ea5e9', tension: 0.4 }, 
                { label: 'ET0', data: ds.et0, borderColor: '#10b981', tension: 0.4 } 
            ]}, options: hOpts });

            chartInstances['h4'] = new Chart(resetChart('h4'), { type: 'line', data: { labels: lbl, datasets: [ 
                { label: '0-7cm', data: ds.soilT7, borderColor: '#ef4444', tension: 0.4 }, 
                { label: '7-28cm', data: ds.soilT28, borderColor: '#f59e0b', tension: 0.4 } 
            ]}, options: hOpts });

            chartInstances['h5'] = new Chart(resetChart('h5'), { type: 'bar', data: { labels: lbl, datasets: [ 
                { label: 'Low', data: ds.cloudLow || Array(24).fill(0), backgroundColor: '#94a3b8' }, 
                { label: 'Mid', data: ds.cloudMid || Array(24).fill(0), backgroundColor: '#cbd5e1' }, 
                { label: 'High', data: ds.cloudHigh || Array(24).fill(0), backgroundColor: '#e2e8f0' } 
            ]}, options: { ...hOpts, scales: { x: { ...opts.scales.x, stacked: true }, y: { ...opts.scales.y, stacked: true } } } });

            chartInstances['h6'] = new Chart(resetChart('h6'), { type: 'line', data: { labels: lbl, datasets: [ 
                { label: '100m Wind', data: ds.wind100m, borderColor: '#10b981', fill: true, backgroundColor: 'rgba(16,185,129,0.1)', tension: 0.2 }, 
                { label: 'Turbine Safety Cut-In (12km/h)', data: Array(24).fill(12), borderColor: '#ef4444', borderDash: [5,5], pointRadius: 0 } 
            ]}, options: hOpts });
        }

        document.getElementById('hourSlider').addEventListener('input', (e) => updateHourlyKPIs(e.target.value));
        document.getElementById('datePicker').addEventListener('change', fetchHourlyData);


        // --- SECTION 2: YEARLY LOGIC ---
        const yearPicker = document.getElementById('yearPicker');
        for (let y = 2025; y >= 2015; y--) { let opt = document.createElement('option'); opt.value = y; opt.innerHTML = y + " Season"; if (y === 2023) opt.selected = true; yearPicker.appendChild(opt); }
        let renderY = false;
        async function fetchYearlyData() {
            try {
                const response = await fetch(`/Dashboard/GetYearlyData?year=${yearPicker.value}`);
                const data = await response.json();
                if (!data || !data.solar) return;

                chartInstances['y1'] = new Chart(resetChart('y1'), { type: 'bar', data: { labels: data.solar.labels, datasets: [{ label: 'Avg Radiation', data: data.solar.values, backgroundColor: '#f59e0b', borderRadius: 4 }] }, options: opts });
                chartInstances['y2'] = new Chart(resetChart('y2'), { type: 'bar', data: { labels: data.sunshine.labels, datasets: [{ label: 'Cloud Cover %', type: 'line', data: data.cloud.values, borderColor: '#64748b', yAxisID: 'y1' }, { label: 'Sunlight Hours/Day', data: data.sunshine.values, backgroundColor: '#eab308' }]}, options: { ...opts, scales: { y1: { position: 'right' } } } });
                chartInstances['y3'] = new Chart(resetChart('y3'), { type: 'line', data: { labels: data.tempMax.labels, datasets: [{ label: 'Max Temp', data: data.tempMax.values, borderColor: '#ef4444', backgroundColor: 'rgba(239, 68, 68, 0.1)', fill: true }, { label: 'Min Temp', data: data.tempMin.values, borderColor: '#0ea5e9' }]}, options: opts });
                chartInstances['y4'] = new Chart(resetChart('y4'), { type: 'line', data: { labels: data.wind.labels, datasets: [{ label: 'Max Wind', data: data.wind.values, borderColor: '#3b82f6', fill: true, backgroundColor: 'rgba(59,130,246,0.1)' }, { label: 'Gusts', data: data.gust.values, borderColor: '#ef4444', borderDash: [2,2] }]}, options: opts });
                chartInstances['y5'] = new Chart(resetChart('y5'), { type: 'line', data: { labels: data.soil.labels, datasets: [{ label: 'Soil Temp', data: data.soil.values, borderColor: '#84cc16', fill: true, backgroundColor: 'rgba(132,204,22,0.1)' }]}, options: opts });
                chartInstances['y6'] = new Chart(resetChart('y6'), { type: 'bar', data: { labels: data.vpd.labels, datasets: [{ label: 'VPD (kPa)', type: 'line', data: data.vpd.values, borderColor: '#0ea5e9', yAxisID: 'y' }, { label: 'ET₀ (mm)', data: data.et0.values, backgroundColor: '#10b981', yAxisID: 'y1' }]}, options: { ...opts, scales: { y1: { position: 'right' } } } });
                renderY = true;
            } catch (error) { console.error(error); }
        }
        yearPicker.addEventListener('change', () => { renderY = false; fetchYearlyData(); });
        document.getElementById('pills-yearly-tab').addEventListener('shown.bs.tab', function () { if (!renderY) fetchYearlyData(); });


        // ==========================================
        // NEW SECTION 3: DECADE LOGIC (9 Charts mapped to Service)
        // ==========================================
        let renderD = false;
        async function fetchDecadeData() {
            try {
                const response = await fetch('/Dashboard/GetDecadeData');
                const data = await response.json();
                if (!data) return;

                const dOpts = { responsive: true, maintainAspectRatio: false, scales: { x: { grid: { color: gLine } }, y: { grid: { color: gLine } } } };

                // 16. Irradiance vs Cloud Cover
                chartInstances['d1'] = new Chart(resetChart('d1'), { type: 'bar', data: { labels: data.radDecade.labels, datasets: [
                    { label: 'Cloud Cover (%)', type: 'line', data: data.cloudDecade.values, borderColor: '#64748b', yAxisID: 'y1', tension: 0.3 },
                    { label: 'Avg Irradiance (W/m²)', data: data.radDecade.values, backgroundColor: '#f59e0b', borderRadius: 4 }
                ]}, options: { ...dOpts, scales: { y1: { position: 'right' } } } });

                // 17. Thermal Degradation Days (>35 and >40)
                chartInstances['d2'] = new Chart(resetChart('d2'), { type: 'bar', data: { labels: data.heat35.labels, datasets: [
                    { label: 'Extreme Days > 40°C', data: data.heat40.values, backgroundColor: '#991b1b' }, 
                    { label: 'Danger Days > 35°C', data: data.heat35.values, backgroundColor: '#ef4444' }  
                ]}, options: { ...dOpts, scales: { y: { stacked: false }, x: { stacked: false } } } });

                // 18. Structural Wind Loads
                chartInstances['d3'] = new Chart(resetChart('d3'), { type: 'line', data: { labels: data.windDecade.labels, datasets: [
                    { label: 'Mean Sustained Wind', data: data.windDecade.values, borderColor: '#3b82f6', fill: true, backgroundColor: 'rgba(59,130,246,0.1)', tension: 0.3 },
                    { label: 'Absolute Peak Gust', data: data.gustDecade.values, borderColor: '#ef4444', borderDash: [5,5], tension: 0.3 }
                ]}, options: dOpts });

                // 19. Sunlight Efficiency Ratio
                chartInstances['d4'] = new Chart(resetChart('d4'), { type: 'line', data: { labels: data.sunRatio.labels, datasets: [
                    { label: 'Sunshine / Daylight Ratio (%)', data: data.sunRatio.values, borderColor: '#eab308', fill: true, backgroundColor: 'rgba(234, 179, 8, 0.1)', tension: 0.3 }
                ]}, options: dOpts });

                // 20. Total Annual Evaporation
                chartInstances['d5'] = new Chart(resetChart('d5'), { type: 'bar', data: { labels: data.et0Total.labels, datasets: [
                    { label: 'Total Annual ET₀ (mm)', data: data.et0Total.values, backgroundColor: '#10b981', borderRadius: 4 }
                ]}, options: dOpts });

                // 21. Extreme Wet-Bulb
                chartInstances['d6'] = new Chart(resetChart('d6'), { type: 'line', data: { labels: data.wetBulb.labels, datasets: [
                    { label: 'Avg Max Wet-Bulb Temp (°C)', data: data.wetBulb.values, borderColor: '#0ea5e9', fill: true, backgroundColor: 'rgba(14, 165, 233, 0.1)', tension: 0.3 }
                ]}, options: dOpts });

                // 22. Deep Soil Saturation
                chartInstances['d7'] = new Chart(resetChart('d7'), { type: 'line', data: { labels: data.soilTempDecade.labels, datasets: [
                    { label: 'Deep Soil Temp 0-100cm (°C)', data: data.soilTempDecade.values, borderColor: '#84cc16', tension: 0.3 }
                ]}, options: dOpts });

                // 23. Soil Moisture/Aridity
                chartInstances['d8'] = new Chart(resetChart('d8'), { type: 'line', data: { labels: data.soilMoistDecade.labels, datasets: [
                    { label: 'Deep Soil Moisture (m³/m³)', data: data.soilMoistDecade.values, borderColor: '#0f172a', fill: true, backgroundColor: 'rgba(15, 23, 42, 0.1)', tension: 0.3 }
                ]}, options: dOpts });

                // 24. Humidity Envelopes
                chartInstances['d9'] = new Chart(resetChart('d9'), { type: 'line', data: { labels: data.humMax.labels, datasets: [
                    { label: 'Avg Max Humidity', data: data.humMax.values, borderColor: '#3b82f6', tension: 0.3 },
                    { label: 'Avg Min Humidity', data: data.humMin.values, borderColor: '#64748b', borderDash: [4,4], tension: 0.3 }
                ]}, options: dOpts });

                renderD = true;
            } catch (error) { console.error("Error fetching decade data", error); }
        }

        document.getElementById('pills-decade-tab').addEventListener('shown.bs.tab', function () { if (!renderD) fetchDecadeData(); });

        fetchHourlyData();
    </script>
}