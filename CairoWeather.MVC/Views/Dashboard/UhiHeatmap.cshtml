@{
    ViewData["Title"] = "UHI Heatmap";
}

<style>
    #map {
        height: 450px;
        border-radius: 16px;
        border: 2px solid #e2e8f0;
        z-index: 1;
    }

    .solar-stress-container {
        height: 450px;
        background: #0f172a;
        border-radius: 16px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: white;
        position: relative;
    }

    .dynamic-panel {
        width: 180px;
        height: 120px;
        background: repeating-linear-gradient(90deg, #1e40af, #1e40af 12px, #1d4ed8 13px);
        border: 4px solid #cbd5e1;
        transform: rotateX(50deg) rotateZ(-15deg);
        transition: all 0.5s ease;
        position: relative;
    }

    .heat-glow {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        transition: background 0.5s ease;
    }

    .uhi-legend {
        background: white;
        padding: 10px 15px;
        border-radius: 10px;
        border: 1px solid #e2e8f0;
        font-size: 0.8rem;
    }

    .legend-item {
        display: flex;
        align-items: center;
        margin-bottom: 5px;
        font-weight: bold;
    }

    .legend-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        margin-right: 8px;
    }
</style>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm p-3" style="border-radius: 16px;">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold m-0"><i class="fa-solid fa-temperature-arrow-up text-danger me-2"></i>Urban Heat Island Effect</h5>
                <div class="uhi-legend shadow-sm">
                    <div class="legend-item"><span class="legend-dot" style="background:#ef4444"></span> Extreme (+3°C)</div>
                    <div class="legend-item"><span class="legend-dot" style="background:#f97316"></span> High (+2°C)</div>
                    <div class="legend-item"><span class="legend-dot" style="background:#eab308"></span> Mild (+1°C)</div>
                    <div class="legend-item"><span class="legend-dot" style="background:#10b981"></span> Neutral (0°C)</div>
                    <div class="legend-item"><span class="legend-dot" style="background:#3b82f6"></span> Cool (-1°C)</div>
                </div>
            </div>

            <div id="map"></div>

            <div class="card border-0 shadow-sm p-4 mt-3" style="border-radius: 16px; background-color: #f8fafc;">
                <h6 class="fw-bold text-dark mb-3"><i class="fa-solid fa-square-root-variable me-2 text-primary"></i>Thermodynamics Physics Engine</h6>

                <div class="bg-white p-3 rounded-3 border mb-3">
                    <p class="small fw-bold text-muted mb-2 text-uppercase">1. Cell Temperature (NOCT Formula)</p>
                    <div class="font-monospace text-dark text-center fw-bold" style="font-size: 1.1rem;">
                        T<sub>cell</sub> = T<sub>ambient</sub> + [ ( <span class="text-primary">NOCT</span> - 20 ) / 800 ] &times; G
                    </div>
                    <p class="text-muted small mt-2 mb-0 text-center">
                        Where: <strong>NOCT</strong> (Nominal Operating Cell Temp) = 45°C, <strong>G</strong> (Irradiance) &approx; 800-1000 W/m².<br>
                        <em>Simplified Engine Model: T<sub>cell</sub> &approx; T<sub>ambient</sub> + 25°C</em>
                    </p>
                </div>

                <div class="bg-white p-3 rounded-3 border">
                    <p class="small fw-bold text-muted mb-2 text-uppercase">2. Thermal Derating (Efficiency Loss)</p>
                    <div class="font-monospace text-dark text-center fw-bold" style="font-size: 1.1rem;">
                        Loss (%) = ( T<sub>cell</sub> - <span class="text-success">25°C</span> ) &times; <span class="text-danger">&beta;</span>
                    </div>
                    <p class="text-muted small mt-2 mb-0 text-center">
                        Where: <strong>25°C</strong> is the STC baseline. <strong>&beta;</strong> is the Temperature Coefficient.<br>
                        <em>For standard Silicon panels: &beta; = 0.4% per 1°C rise.</em>
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="solar-stress-container shadow-sm" id="stressContainer">
            <h4 class="fw-bold mb-2 text-warning" id="regionName">Select a Region</h4>
            <p class="small text-light opacity-75 mb-4">Base Ambient Temp: <span id="baseTempDisplay">35</span>°C</p>

            <div class="dynamic-panel" id="solarPanel">
                <div class="heat-glow" id="heatGlow"></div>
            </div>

            <div class="mt-4 p-3 w-75 rounded text-center" style="background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2);">
                <p class="mb-1 text-light small">Actual Cell Temp</p>
                <h3 class="fw-bold text-warning mb-2" id="cellTemp">-- °C</h3>
                <p class="mb-1 text-light small">Efficiency Loss</p>
                <h4 class="fw-bold text-danger mb-0" id="effLoss">-- %</h4>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var map;
        const BASE_TEMP = 35;

        function initMap() {
            map = L.map('map').setView([30.0444, 31.2357], 10);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '© OpenStreetMap'
            }).addTo(map);

            const regions = [
                { name: "Downtown (Tahrir)", lat: 30.0444, lng: 31.2357, tempOffset: 3, color: "#ef4444", label: "Extreme UHI (High Stress)" },
                { name: "Shubra", lat: 30.0713, lng: 31.2426, tempOffset: 3, color: "#ef4444", label: "Extreme UHI (High Stress)" },
                { name: "Imbaba", lat: 30.0745, lng: 31.2104, tempOffset: 3, color: "#ef4444", label: "Extreme UHI (High Stress)" },
                { name: "Faisal / Haram", lat: 29.9972, lng: 31.1578, tempOffset: 3, color: "#ef4444", label: "Extreme UHI (High Stress)" },
                { name: "El Marg", lat: 30.1531, lng: 31.3361, tempOffset: 3, color: "#ef4444", label: "Extreme UHI (High Stress)" },

                { name: "Nasr City", lat: 30.0626, lng: 31.3242, tempOffset: 2, color: "#f97316", label: "High UHI (Moderate Stress)" },
                { name: "Heliopolis", lat: 30.1001, lng: 31.3298, tempOffset: 2, color: "#f97316", label: "High UHI (Moderate Stress)" },
                { name: "Dokki / Agouza", lat: 30.0381, lng: 31.2014, tempOffset: 2, color: "#f97316", label: "High UHI (Moderate Stress)" },
                { name: "Helwan", lat: 29.8398, lng: 31.3388, tempOffset: 2, color: "#f97316", label: "Industrial/Urban Heat" },

                { name: "Maadi", lat: 29.9598, lng: 31.2596, tempOffset: 1, color: "#eab308", label: "Mild UHI (Low Stress)" },
                { name: "Zamalek", lat: 30.0626, lng: 31.2200, tempOffset: 1, color: "#eab308", label: "Mild UHI (Low Stress)" },
                { name: "Manial", lat: 30.0150, lng: 31.2260, tempOffset: 1, color: "#eab308", label: "Mild UHI (Low Stress)" },

                { name: "New Cairo", lat: 30.0300, lng: 31.4700, tempOffset: 0, color: "#10b981", label: "Neutral Zone (Optimal)" },
                { name: "Mokattam", lat: 30.0167, lng: 31.2833, tempOffset: 0, color: "#10b981", label: "Elevated Zone (Optimal)" },
                { name: "Rehab City", lat: 30.0601, lng: 31.4930, tempOffset: 0, color: "#10b981", label: "Neutral Zone (Optimal)" },
                { name: "Obour City", lat: 30.2201, lng: 31.4646, tempOffset: 0, color: "#10b981", label: "Neutral Zone (Optimal)" },

                { name: "6th of October", lat: 29.9700, lng: 30.9400, tempOffset: -1, color: "#3b82f6", label: "Cool Zone (High Efficiency)" },
                { name: "Sheikh Zayed", lat: 30.0441, lng: 30.9850, tempOffset: -1, color: "#3b82f6", label: "Cool Zone (High Efficiency)" },
                { name: "New Capital (NAC)", lat: 29.9868, lng: 31.7333, tempOffset: -1, color: "#3b82f6", label: "Cool Zone (High Efficiency)" },
                { name: "Madinaty", lat: 30.0911, lng: 31.6025, tempOffset: -1, color: "#3b82f6", label: "Cool Zone (High Efficiency)" },
                { name: "Shorouk", lat: 30.1423, lng: 31.6258, tempOffset: -1, color: "#3b82f6", label: "Cool Zone (High Efficiency)" }
            ];

            regions.forEach(r => {
                L.circleMarker([r.lat, r.lng], {
                    color: r.color,
                    fillColor: r.color,
                    fillOpacity: 0.7,
                    radius: 12
                })
                 .addTo(map)
                 .bindTooltip(`
                    <div style="font-weight: 800; color: #0f172a; font-size: 1.1rem; text-align: center;">${r.name}</div>
                    <div style="color: ${r.color}; font-size: 0.85rem; font-weight: 700; text-align: center; margin-top: 4px; padding: 2px 6px; background: rgba(0,0,0,0.05); border-radius: 4px;">
                        <i class="fa-solid fa-circle me-1"></i>${r.label}
                    </div>
                 `, {
                     permanent: false,
                     direction: 'top',
                     className: 'border-0 shadow-sm'
                 })
                 .on('click', () => { simulateRegion(r); map.flyTo([r.lat, r.lng], 13); });
            });

            simulateRegion(regions[12]);
        }

        initMap();

        const mapDiv = document.getElementById('map');
        const observer = new ResizeObserver(function() {
            if(map && mapDiv.clientWidth > 0) {
                map.invalidateSize();
            }
        });
        observer.observe(mapDiv);

        function simulateRegion(region) {
            const cellTemp = BASE_TEMP + region.tempOffset + 25;
            let loss = Math.max(0, (cellTemp - 25) * 0.4);

            document.getElementById('regionName').innerText = region.name;
            document.getElementById('cellTemp').innerText = cellTemp.toFixed(1) + " °C";
            document.getElementById('effLoss').innerText = "-" + loss.toFixed(1) + " %";

            const glow = document.getElementById('heatGlow');

            if (region.tempOffset >= 3) {
                glow.style.background = "rgba(239, 68, 68, 0.8)";
                document.getElementById('effLoss').className = "fw-bold text-danger mb-0";
            } else if (region.tempOffset >= 1) {
                glow.style.background = "rgba(245, 158, 11, 0.6)";
                document.getElementById('effLoss').className = "fw-bold text-warning mb-0";
            } else if (region.tempOffset < 0) {
                glow.style.background = "rgba(59, 130, 246, 0.6)";
                document.getElementById('effLoss').className = "fw-bold text-info mb-0";
            } else {
                glow.style.background = "transparent";
                document.getElementById('effLoss').className = "fw-bold text-success mb-0";
            }
        }
    </script>
}